NODE_ENV=development
PORT=3001

# Use the Session pooler URL (port 5432) for a persistent Render service.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:5432/postgres
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=8h

FRONTEND_URL=http://localhost:5173
FRONTEND_URLS=http://localhost:5173,https://your-project.vercel.app
TRUST_PROXY=1
BLOCKED_IPS=

# Optional: reserved for future e-mail notifications.
# RESEND_API_KEY=re_replace_me
# RESEND_FROM=Houzen <no-reply@your-verified-domain.example>

# Required only while Firebase is used for Google sign-in.
FIREBASE_PROJECT_ID=your-firebase-project-id
